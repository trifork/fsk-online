{
  "plugins": ["promise"],
  "categories": {
    "correctness": "warn",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off"
  },
  "rules": {
    "no-else-return": "off",
    "no-extra-boolean-cast": "off",
    "no-floating-promises": "off",
    "no-unsafe-optional-chaining": "off",
    "no-unused-expressions": "off",
    "no-unused-vars": "off",
    "no-useless-escape": "off",
    "prefer-await-to-then": "off"
  }
}
